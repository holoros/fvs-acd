 # $Id: AcadianGY.R 3968 2022-04-28 10:36:05Z nickcrookston $
 ################################################################################
+# v12.3.10: site-driver modernization. The site index is sourced from the modern
+# unified-target ESI by default instead of the legacy Climate Site Index. ESI and
+# CSI are both site index in meters, so this is an INPUT change only; no growth,
+# height, mortality, or ingrowth equation is modified. Resolution order inside
+# AcadianGYOneStand: stand$ESI (per-stand override) > ESI raster (ops$ESI_RASTER)
+# sampled at stand$LON/LAT > legacy stand$CSI. ops$SITE_SOURCE = "CSI_legacy"
+# reproduces 12.3.9 behavior exactly; ops$CSI_SCALE is retained.
+# Validation: HTPred height R^2 0.358 -> 0.384, bias +1.87 -> +1.75 m; 0 Bakuzis
+# crossings; Seven Islands CFI projections within 1 pp of legacy (safe swap).
+################################################################################
+# ESI raster sampler with a cached SpatRaster (terra). Returns NA off-grid.
+.esi_cache <- new.env(parent = emptyenv())
+.esi_at <- function(path, lon, lat) {
+  if (!requireNamespace("terra", quietly = TRUE)) return(NA_real_)
+  r <- get0(path, envir = .esi_cache, inherits = FALSE)
+  if (is.null(r)) { r <- terra::rast(path)[[1]]; assign(path, r, envir = .esi_cache) }
+  pt <- terra::vect(data.frame(x = lon, y = lat), geom = c("x", "y"), crs = "EPSG:4326")
+  if (!identical(terra::crs(r), terra::crs(pt))) pt <- terra::project(pt, terra::crs(r))
+  v <- try(terra::extract(r, pt)[[2]], silent = TRUE)
+  if (!inherits(v, "try-error") && length(v) && is.finite(v)) as.numeric(v) else NA_real_
+}
+# Legacy CSI -> ESI converter for inputs that carry only the old CSI.
+# From CSI = 3.3717 + 0.7520 * ESI on the Acadian compilation.
+csi_to_esi <- function(csi) (csi - 3.3717) / 0.7520
