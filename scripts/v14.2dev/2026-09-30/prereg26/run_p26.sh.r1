#!/bin/bash
# PREREG26 task wrapper. Usage: run_p26.sh ARM MODE OUT [CELLS_CSV]. Sources the frozen PREREG22 environment file unedited
# (~/jobs/v142p22/home/p22_env.sh, md5 checked) and maps the arm onto it; the only overrides are the ones named below.
#   v141LT    p22_env g0_off ns_c                  (bench141 block: IMULT 2.5, no height form, no threshold matching)
#   v141LTfi  P22_IMULT=1.5, p22_env v141LTfi ns_c (height form b1, b2; ING_MIN_FROM_SCORE=1; IMULT 1.5)
#   v141LTf   p22_env g0_off ns_c, then HTFIX_B1/B2 = P22_B1/B2   (height form only; follow up arm)
#   v141LTi   p22_env g0_off ns_c, then ING_MIN_FROM_SCORE=1 IMULT=1.5 (ingrowth only; follow up arm)
# V141_REPORT_DIR is redirected into ~/jobs/v142p26 so nothing is written under the PREREG22 bundle. Refuses to overwrite.
set -euo pipefail
ARM=$1; MODE=$2; OUT=$3; CELLS=${4:-}
[ ! -e "$OUT" ] || { echo "REFUSE $OUT exists"; exit 3; }
export HOME=/home/aaron/jobs/v142p22/home
E=$HOME/p22_env.sh; [ "$(md5sum $E | cut -d' ' -f1)" = "$(cat /home/aaron/jobs/v142p26/plan/p22_env.md5)" ] || { echo "FATAL p22_env md5"; exit 4; }
source $E
case "$ARM" in
  v141LT)   p22_env g0_off ns_c ;;
  v141LTfi) export P22_IMULT=1.5; p22_env v141LTfi ns_c ;;
  v141LTf)  p22_env g0_off ns_c; export HTFIX_B1=$P22_B1 HTFIX_B2=$P22_B2 ;;
  v141LTi)  p22_env g0_off ns_c; export ING_MIN_FROM_SCORE=1 IMULT=1.5 ;;
  *) echo "bad ARM $ARM"; exit 2 ;;
esac
export V141_REPORT_DIR=/home/aaron/jobs/v142p26/logs/counters_$ARM
export P26_MODE=$MODE P26_OUT=$OUT P26_ARM=$ARM P26_CELLS=$CELLS P26_NYR=${P26_NYR:-100} P26_SMD=${P26_SMD:-9.1}
D=/home/aaron/jobs/v142p26/scripts/driver_p26.R; [ "$(md5sum $D | cut -d' ' -f1)" = 9696daea51f491e74967cca24d08a6aa ] || { echo "FATAL driver md5"; exit 4; }
cd $HOME/magplot/verify
echo "[p26] ARM=$ARM MODE=$MODE IMULT=$IMULT HTFIX_B1=${HTFIX_B1:-unset} ING=${ING_MIN_FROM_SCORE:-unset} SMD=$P26_SMD start=$(date -Is)"
Rscript $D
echo "[p26] DONE $OUT end=$(date -Is)"
