> ## stem map: same raw species, |dDist| <= 0.5 m, circular |dAz| <= 10 deg, one to one, among round 1 trees not already claimed
> num <- function(x) suppressWarnings(as.numeric(x))
> cand1 <- r1[!(paste(Plot_ID, TP) %chin% r2[method == "link", paste(Plot_ID, Tree)]), .(Plot_ID, T1 = TP, sp = toupper(Species), d1 = num(Distance), a1 = num(Azimuth))]
> cand2 <- r2[is.na(method), .(Plot_ID, T2 = TP, sp = toupper(Species), d2 = num(Distance), a2 = num(Azimuth))]
> lg("stemmap_r2_candidates", nrow(cand2)); lg("stemmap_r2_candidates_no_numeric_dist_or_az", cand2[!is.finite(d2) | !is.finite(a2), .N], "compass letters or NA")
> lg("stemmap_r1_pool_no_numeric_dist_or_az", cand1[!is.finite(d1) | !is.finite(a1), .N])
> cm <- merge(cand1[is.finite(d1) & is.finite(a1)], cand2[is.finite(d2) & is.finite(a2)], by = c("Plot_ID", "sp"), allow.cartesian = TRUE)
> cm[, `:=`(dd = abs(d1 - d2), da = { z <- abs(a1 - a2) %% 360; pmin(z, 360 - z) })]
> cm <- cm[dd <= TOL_DIST & da <= TOL_AZ]
> cm[, score := dd / TOL_DIST + da / TOL_AZ]
> setorder(cm, score, T2, T1)                                          # [SET ON AUTOPILOT] greedy one to one on normalized distance, ties by TP_ID
> u1 <- integer(); u2 <- integer(); acc <- vector("list", nrow(cm)); k <- 0L
> for (i in seq_len(nrow(cm))) { a <- cm$T1[i]; b <- cm$T2[i]
