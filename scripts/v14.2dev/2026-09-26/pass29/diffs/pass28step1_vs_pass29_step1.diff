> ## tag rule: Tree = round 1 TP_ID; a round 2 tree takes its TreeLink target when that target is a round 1 TP_ID of the
> ## same plot (and dated), else a stem map match, else 9,000,000 + TP_ID (untracked)
> r1 <- lt[Visit == 1L]; r2 <- lt[Visit == 2L]
> r1[, `:=`(Tree = TP, method = "r1")]
> r2[, TL := suppressWarnings(as.integer(TreeLink))]
> r2[, link_ok := !is.na(TL) & paste(Plot_ID, TL) %chin% paste(r1$Plot_ID, r1$TP)]
> setorder(r2, Plot_ID, TL, TP)
> r2[link_ok == TRUE, link_rank := seq_len(.N), by = .(Plot_ID, TL)]
> lg("r2_link_valid", r2[link_ok == TRUE, .N]); lg("r2_link_absent", r2[is.na(TL), .N])
> lg("r2_link_not_r1_same_plot", r2[!is.na(TL) & link_ok == FALSE, .N])
> lg("r2_link_duplicate_target_to_stem_map", r2[link_ok == TRUE & link_rank > 1L, .N], "[SET ON AUTOPILOT] lowest TP_ID keeps a shared target")
> r2[, method := fifelse(link_ok == TRUE & link_rank %in% 1L, "link", NA_character_)]
